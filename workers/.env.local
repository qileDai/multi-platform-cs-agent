# ===== RPA Worker 配置（复制为 .env.local 后填写）=====

# 后端地址（部署后端的服务器）
BACKEND_URL=http://127.0.0.1:8000

# 与后端 .env 的 RPA_API_KEY 完全一致
# 生成方式：python -c "import secrets;print(secrets.token_hex(16))"
RPA_API_KEY=cbdc3c401029c24d38aee65242f5721c

# Worker 标识（同一店铺账号下唯一）
WORKER_ID=worker-douyin-01

# 店铺账号标识（多店铺隔离的关键：每个店铺一个 account，一个 Worker）
# 后端会话 ID 会以 "<account>:" 为前缀，outbox 按此路由
ACCOUNT=my-shop

# 平台：douyin（飞鸽后台） | xiaohongshu（千帆后台）
PLATFORM=douyin

# 无头模式：生产 true（Windows 锁屏也不影响）；调试页面时 false
HEADLESS=true

# 浏览器登录态目录（每个 account 独立）
PROFILE_DIR=./profiles

# 轮询间隔（秒）：outbox 拉取 / 入站监听
POLL_INTERVAL=2
# 心跳间隔（秒）
HEARTBEAT_INTERVAL=10

# 本地状态库（身份缓存 + 消息去重）
STATE_DB=./worker_state.db
# 待发媒体下载目录
DOWNLOAD_DIR=./downloads
