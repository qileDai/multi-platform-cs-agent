# ===== RPA Worker 配置（复制为 .env.local 后填写）=====

# 后端地址（部署后端的服务器）
BACKEND_URL=http://127.0.0.1:8000

# 与后端 .env 的 RPA_API_KEY 完全一致
# 生成方式：python -c "import secrets;print(secrets.token_hex(16))"
RPA_API_KEY=

# Worker 标识（同一店铺账号下唯一）
WORKER_ID=worker-douyin-01

# 店铺账号标识（多店铺隔离的关键：每个店铺一个 account，一个 Worker）
# 后端会话 ID 会以 "<account>:" 为前缀，outbox 按此路由
ACCOUNT=my-shop

# 平台：douyin（飞鸽后台，抖店商家） | douyin_enterprise（企业号后台 e.douyin.com，蓝V 无抖店） | xiaohongshu（千帆后台）
# 注：douyin_enterprise 上报后端时归 douyin 渠道；后端需设 DOUYIN_ACCOUNT_TYPE=enterprise 以对齐企业号频控
PLATFORM=douyin

# 平台后台入口地址覆盖（留空用内置默认；平台改地址时在此覆盖，无需改代码）
# 飞鸽默认 https://im.jinritemai.com/pc_seller_v2/main/workspace
# 企业号默认 https://e.douyin.com/（消息管理页确切路径冒烟确认后在此固化）
# 千帆默认 https://ark.xiaohongshu.com/ark/message/platform/msg
PLATFORM_URL=

# 无头模式：生产 true（Windows 锁屏也不影响）；调试页面时 false
HEADLESS=true

# 浏览器登录态目录（每个 account 独立）
PROFILE_DIR=./profiles

# 轮询间隔（秒）：outbox 拉取 / 入站监听
POLL_INTERVAL=2
# 心跳间隔（秒）
HEARTBEAT_INTERVAL=10

# 本地状态库（身份缓存 + 消息去重）
STATE_DB=./worker_state.db
# 待发媒体下载目录
DOWNLOAD_DIR=./downloads
